# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# These are read on the server only. They are never sent to the browser: pages ship
# the resulting in-stock boolean and nothing else, so visitors can't see the upstream.
# Do NOT prefix any of them with NEXT_PUBLIC_ — that would inline them into the bundle.

# Reseller API base URL, including the version path, no trailing slash.
# Same value as Luxvps-stock-bot's API_BASE_URL (/opt/luxvps-stock-bot/.env on the VPS).
LUXVPS_API_BASE_URL=https://host.example/v1

# Reseller API key. Same value as Luxvps-stock-bot's LUXVPS_API_TOKEN.
LUXVPS_API_TOKEN=your-api-key-here

# Optional: comma-separated product lines to poll, overriding DEFAULT_LINES in
# lib/stock-catalog.ts. Set this if you'd rather the line slugs weren't in git.
# LUXVPS_API_LINES=line-one,line-two

# Optional: canonical site URL used in metadata/sitemap. Defaults to https://deals.luxvps.net
# NEXT_PUBLIC_SITE_URL=https://deals.luxvps.net
